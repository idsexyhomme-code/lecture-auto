  "_inspired_by": {
    "조선업주작업물": {
      "몽생이": "제주 캐릭터 — 베이지 + 코랄 + 라이트 그린",
      "환경공단": "공공 신뢰 — 미드나잇 블루 + 화이트 + 옅은 그레이",
      "워터밤_JIBS": "이벤트 임팩트 — 채도 높은 컬러 + 굵은 헤드라인",
      "감귤박람회": "제주 따뜻함 — 베이지 + 오렌지 + 올리브"
    },
    "외부_표준": {
      "토스": "여백 / 작은 모서리 / 차분한 컬러",
      "클래스101": "인물 사진 강조 / 큰 컬러 블록 / 또렷한 가격",
      "인프런": "정보 밀도 / 차가운 톤 / 카드 그리드",
      "노션_KR": "타이포 위주 / 미니멀 / 흑백+포인트"
    },
    "_결정": "Core Campus는 (제주 베이지 + 코랄) × (토스의 절제된 여백) × (인프런의 정보 밀도) — 따뜻하면서 신뢰감 있고 정보 빠르게 전달"
  }
}
