/div>\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <div style=\"background:rgba(255,255,255,0.06);border:1px solid rgba(200,180,140,0.2);border-radius:var(--radius-card,8px);padding:20px 24px;backdrop-filter:blur(8px);\">\n        <span style=\"font-size:13px;font-weight:600;color:var(--accent,#E8C87A);display:block;margin-bottom:8px;\">수강생 후기</span>\n        <p style=\"font-size:15px;line-height:1.6;color:#E8E0D0;margin:0 0 10px;\">&ldquo;강의 듣고 다음 날부터 바로 적용했습니다. 한 달 만에 외주비 200만 원을 줄였어요.&rdquo;</p>\n        <small style=\"font-size:12px;color:#8A8070;\">— 브랜드 컨설턴트</small>\n      </div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n        <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(200,180,140,0.15);border-radius:var(--radius-card,8px);padding:16px 20px;\">\n          <span style=\"font-size:28px;font-weight:900;color:#F5F0E8;display:block;\">1,200<span style=\"color:var(--accent,#E8C87A);\">+</span></span>\n          <span style=\"font-size:12px;color:#8A8070;\">누적 수강생</span>\n        </div>\n        <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(200,180,140,0.15);border-radius:var(--radius-card,8px);padding:16px 20px;\">\n          <span style=\"font-size:28px;font-weight:900;color:#F5F0E8;display:block;\">3<span style=\"color:var(--accent,#E8C87A);\">hr</span></span>\n          <span style=\"font-size:12px;color:#8A8070;\">평균 절약 시간/일</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
