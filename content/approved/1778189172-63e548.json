endard',system-ui,sans-serif);\">\n        <div style=\"font-size:22px;font-weight:700;color:var(--fg,#1C1815);\">4주</div>\n        <div style=\"font-size:12px;color:#8A7A6A;margin-top:2px;\">집중 과정</div>\n      </div>\n      <div style=\"width:1px;background:#DDD5C8;\"></div>\n      <div style=\"font-family:var(--font-family-sans,'Pretendard',system-ui,sans-serif);\">\n        <div style=\"font-size:22px;font-weight:700;color:var(--fg,#1C1815);\">12강</div>\n        <div style=\"font-size:12px;color:#8A7A6A;margin-top:2px;\">실전 레슨</div>\n      </div>\n      <div style=\"width:1px;background:#DDD5C8;\"></div>\n      <div style=\"font-family:var(--font-family-sans,'Pretendard',system-ui,sans-serif);\">\n        <div style=\"font-size:22px;font-weight:700;color:var(--fg,#1C1815);\">1인 사업가</div>\n        <div style=\"font-size:12px;color:#8A7A6A;margin-top:2px;\">전용 설계</div>\n      </div>\n    </div>\n  </div>\n  <figure style=\"margin:0;position:relative;\">\n    <div style=\"border-radius:var(--radius-card,8px);overflow:hidden;background:var(--soft,#EDE5D8);aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;\">\n      <img src=\"/assets/placeholder/hero-editorial.svg\" alt=\"가격 페이지 설계 과정을 보여주는 추상 일러스트\" style=\"width:100%;height:100%;object-fit:cover;border-radius:var(--radius-card,8px);\" />\n    </div>\n    <figcaption style=\"margin-top:10px;font-family:var(--font-family-sans,'Pretendard',system-ui,sans-serif);font-size:11px;color:#9A8A7A;text-align:right;letter-spacing:0.04em;\">Core Campus 수강생 가격 페이지 작업 예시</figcaption>\n    <div style=\"position:absolute;top:-16px;right:-16px;width:80px;height:80px;border-radius:50%;background:var(--accent,#A0732A);display:flex;align-items:center;justify-content:center;\">\n      <span style=\"font-family:var(--font-family-sans,'Pretendard',system-ui,sans-serif);font-size:11px;font-weight:700;color:#FBF8F3;text-align:center;line-height:1.3;\">Claude<br>활용</span>\n    </div>\n  </figure>\n</div>",
